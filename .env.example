# Copy to .env and fill in. Every upstream is optional; unset ones show as
# "not_configured" at /api/health/upstreams.

# SOFARR_PORT=5656
# SOFARR_LOG_LEVEL=info
# SOFARR_REGION=US        # release dates (ISO 3166-1)
# SOFARR_LANGUAGE=en-US   # TMDb titles/overviews

SOFARR_PLEX_URL=http://plex:32400

SOFARR_RADARR_URL=http://radarr:7878
SOFARR_RADARR_API_KEY=
# Optional: override what "Get it" uses (default: what most of your library uses)
# SOFARR_RADARR_QUALITY_PROFILE=HD-1080p
# SOFARR_RADARR_ROOT_FOLDER=/data/media/movies

SOFARR_SONARR_URL=http://sonarr:8989
SOFARR_SONARR_API_KEY=
# SOFARR_SONARR_QUALITY_PROFILE=HD-1080p
# SOFARR_SONARR_ROOT_FOLDER=/data/media/tv

SOFARR_QBITTORRENT_URL=http://qbittorrent:8080
# Leave blank if qBittorrent bypasses auth for Sofarr's address.
SOFARR_QBITTORRENT_USERNAME=
SOFARR_QBITTORRENT_PASSWORD=

# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token)
SOFARR_TMDB_API_KEY=
